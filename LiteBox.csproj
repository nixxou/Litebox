<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window by default (transparent when launched by the launcher); a console
         is allocated at runtime only for the debug / headless flags (see Program.cs). -->
    <OutputType>WinExe</OutputType>
    <!-- DUAL-TARGET: LaunchBox 13.x runs on .NET 9; the newer alpha moved to .NET 10. LiteBox borrows LB's
         SDK (Unbroken.LaunchBox.Plugins) at runtime, so it must run on the SAME runtime family — hence one
         build per TFM. Publish selects one with -f (see build-release.ps1 / BUILD-RELEASE.md). A net10
         SELF-CONTAINED build also runs on a .NET 9 LB (net9 SDK loads fine on a net10 runtime), but a net10
         framework-dependent zip needs a net10 runtime present — so we ship both TFM sets. -->
    <TargetFrameworks>net9.0-windows;net10.0-windows</TargetFrameworks>
    <!-- Benign here: the SDK/Magick/Sqlite refs below are version-agnostic (Private=false, resolved from
         LB\Core at runtime). The net9 build referencing the net10 LB\Core copies raises MSB3277 version
         conflicts that resolve to the net9 framework — demote them to messages to keep the build clean. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Output exe is LiteBox.exe. RootNamespace stays LbApiHost (the C#
         namespaces are unchanged; only the produced assembly/file is renamed). -->
    <AssemblyName>LiteBox</AssemblyName>
    <RootNamespace>LbApiHost</RootNamespace>
    <ApplicationIcon>litebox.ico</ApplicationIcon>
    <!-- LiteBox version, read back at boot for upgrade/migration (see Host\Install\LiteBoxVersion). Bump
         this on each release; also raise the matching …Below threshold when a change is breaking. -->
    <Version>0.9.4</Version>
    <!-- Distribution: ONE self-contained single-file exe that is BOTH the installer and the host
         (Program.cs then Host\Install\Installer). Drop it at the LaunchBox root or in Core and it
         self-installs (copies itself to Core, unpacks the EMBEDDED native payload into ThirdParty\).
         The old separate LiteBoxLauncher project is gone (merged here).
         Four release artifacts (2 TFM x 2 forms) are produced by build-release.ps1 — see BUILD-RELEASE.md.
         BOTH forms are SELF-CONTAINED (-p:SelfContained=true); $(LiteBoxDist) picks the shape:
           standalone: dotnet publish ... -f <tfm> -p:PublishSingleFile=true  -p:LiteBoxDist=standalone  (single-file, payload EMBEDDED, self-installing)
           light:      dotnet publish ... -f <tfm> -p:PublishSingleFile=false -p:LiteBoxDist=light        (then STRIP the runtime DLLs so it shares LaunchBox\Core's runtime; payload loose)
         where <tfm> is net9.0-windows or net10.0-windows.
         PublishSingleFile / IncludeNativeLibrariesForSelfExtract only take effect on publish, so a plain
         `dotnet build` stays a fast framework-dependent dev build (self-install skips it: it detects the
         loose LiteBox.dll next to a dev exe and just boots). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Distribution flavor ($(LiteBoxDist), set at publish by build-release.ps1). BOTH forms are
       self-contained; this block only shapes the STANDALONE:
         standalone    -> define FULL_INSTALLER (self-install/relocate active), embed the payload (ItemGroup
                          below) and compress the single-file bundle.
         light / unset -> none of that: the Installer runs Core-only, the payload ships loose in the zip, and
                          (light) the runtime DLLs are stripped after publish so it borrows LaunchBox\Core's. -->
  <PropertyGroup Condition="'$(LiteBoxDist)' == 'standalone'">
    <DefineConstants>$(DefineConstants);FULL_INSTALLER</DefineConstants>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Per-TFM SDK compile reference. A net9 project CANNOT reference LB's net10 build of
       Unbroken.LaunchBox.Plugins (CS1705: that build pulls System.Runtime 10.0.0.0). So the net9 target
       compiles against a .NET 9 LaunchBox's copy and the net10 target against the primary (net10) LB\Core.
       Both are Private=false / resolved by simple name at runtime, so the exact build version only matters
       for the compile. Override the roots with -p:Lb9Root=<.NET 9 LaunchBox> / -p:Lb10Root=<.NET 10 LaunchBox>
       (defaults: the kept net9 backup, and the primary LB beside the repo). build-release.ps1 reads these
       same roots to derive each build's version label. Magick / Sqlite refs below are net8 → they satisfy
       BOTH targets, so they need no split. -->
  <PropertyGroup>
    <Lb9Root  Condition="'$(Lb9Root)' == ''">G:\LB</Lb9Root>
    <Lb10Root Condition="'$(Lb10Root)' == ''">$(MSBuildThisFileDirectory)..\..\..\LB</Lb10Root>
    <!-- LaunchBox 14 install: the net10 SDK COMPILE ref comes from here — v14's SDK adds members
         (IPluginPaths ctor injection, see Host\PluginLoader.Instantiate) the 13.28 copy lacks. Still
         version-agnostic at runtime (Private=false, resolved from the actual LB\Core): the net10 build
         keeps running on 13.28, where the v14-only types are never touched (NoInlining isolation). -->
    <Lb14Root Condition="'$(Lb14Root)' == ''">G:\LB1326</Lb14Root>
    <SdkRefDll Condition="'$(TargetFramework)' == 'net9.0-windows'">$(Lb9Root)\Core\Unbroken.LaunchBox.Plugins.dll</SdkRefDll>
    <SdkRefDll Condition="'$(SdkRefDll)' == ''">$(Lb14Root)\Core\Unbroken.LaunchBox.Plugins.dll</SdkRefDll>
    <!-- WinRT projections (Windows.Graphics.Capture — SmartCapture FPS detection). LaunchBox
         already ships Microsoft.Windows.SDK.NET + WinRT.Runtime in Core, so we compile against
         its copy and resolve at runtime — Private=false, nothing new deployed (same pattern). -->
    <WinRtRefDir Condition="'$(TargetFramework)' == 'net9.0-windows'">$(Lb9Root)\Core</WinRtRefDir>
    <WinRtRefDir Condition="'$(WinRtRefDir)' == ''">$(Lb10Root)\Core</WinRtRefDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real LaunchBox plugin SDK — the exact interface contract we implement (compile-time only,
         Private=false → not copied / not pinned in deps.json; the host resolves whatever version lives in
         LB\Core at runtime, version-agnostic like a plugin). Reference path is per-TFM (see above). -->
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>$(SdkRefDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Magick.NET — WebP decode + thumb generation. Historically compile-time-only against the ExtendDB
         plugin's copy; the plugin never loads under LiteBox (and its folder may be gone), so LiteBox ships the
         managed wrapper itself. SAME VERSION as the bundled native thirdparty\Magick.Native-Q16-x64.dll.api
         (deployed by NativeInstaller + SetDllDirectory) — keep the two in lockstep on upgrades. Like
         LibVLCSharp/ZstdSharp it becomes loose app DLLs (Magick.NET-Q16-AnyCPU.dll + Magick.NET.Core.dll):
         keep build-release.ps1 $appFiles + LightPayload.Files + the light/<tfm> EmbeddedResource block in sync. -->
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.10.4" />
    <!-- SQLite for the write-back operation-log (Core\LiteBox.pending.db). Compile-time only
         (Private=false): LaunchBox already ships Microsoft.Data.Sqlite + SQLitePCLRaw + the
         e_sqlite3 native in LB\Core, so we bind to its copy at runtime and deploy nothing new
         — same version-agnostic pattern as the SDK / Magick above. -->
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>..\..\..\LB\Core\Microsoft.Data.Sqlite.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>..\..\..\LB\Core\SQLitePCLRaw.core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2">
      <HintPath>..\..\..\LB\Core\SQLitePCLRaw.batteries_v2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BouncyCastle: LaunchBox ships it in Core and uses it for its settings cipher (Rijndael-256/CBC/PKCS7).
         Compile-only (Private=false) — resolved from Core at runtime, version-agnostic like the refs above. Lets
         LiteBox read/write LB's encrypted settings (EmuMovies password, …) in the exact same format. -->
    <!-- HID device detector (Launch rules): DirectInput via the SharpDX 4.2.0 LaunchBox ITSELF ships
         in Core (same version BigBoxProfile bundled) - Private=false, we deploy NOTHING and must not:
         our own copy would clobber LaunchBox's. The other three are OUR bundled copies of the exact
         assemblies BigBoxProfile used (HidSharp 2.1.0, ppy.SDL2-CS 1.0.82, 32feet 3.5) - compiled
         against thirdparty\hid\, resolved at runtime from <LB>\ThirdParty\Hid by the lazy
         AssemblyLoadContext hook in Host\Rules\Hid\HidThirdParty (deployed there by NativeInstaller,
         along with the native SDL2.dll 2.0.14). -->
    <Reference Include="SharpDX">
      <HintPath>$(Lb10Root)\Core\SharpDX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX.DirectInput">
      <HintPath>$(Lb10Root)\Core\SharpDX.DirectInput.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HidSharp">
      <HintPath>thirdparty\hid\HidSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDL2-CS">
      <HintPath>thirdparty\hid\SDL2-CS.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InTheHand.Net.Personal">
      <HintPath>thirdparty\hid\InTheHand.Net.Personal.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- C# script rules (Roslyn scripting 4.12): the four assemblies sleep in <LB>\ThirdParty\Roslyn
         (NativeInstaller payload, resolved by RuleScriptEngine lazy ALC hook - nothing lands in Core).
         Private=true so the BIN copy exists for the selftests; deploy-dev hostFiles does not ship
         them to Core, on purpose. -->
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>thirdparty\roslyn\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>thirdparty\roslyn\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Scripting">
      <HintPath>thirdparty\roslyn\Microsoft.CodeAnalysis.Scripting.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Scripting">
      <HintPath>thirdparty\roslyn\Microsoft.CodeAnalysis.CSharp.Scripting.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BouncyCastle.Crypto">
      <HintPath>..\..\..\LB\Core\BouncyCastle.Crypto.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WinRT projection + runtime (Windows.Graphics.Capture etc.), resolved from LB\Core. -->
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(WinRtRefDir)\Microsoft.Windows.SDK.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>$(WinRtRefDir)\WinRT.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WebView2 (YouTube mini-player). LaunchBox 13.28 ships it in Core (Core + WinForms managed wrappers +
         WebView2Loader native); 13.27 does NOT. Compile-only (Private=false) against the net10 Core copies — the
         BOTH-TFM point at Lb10Root because only 13.28 has them. Its PKT (2a8ab48044d2601e) isn't in Program.cs's
         framework skip-list, so the runtime resolver loads it from Core on 13.28; on 13.27 it's absent and
         YouTubePlayerDialog.IsAvailable() catches the load failure → falls back to the system browser. Nothing new
         is deployed (same version-agnostic pattern as the SDK / SQLite / WinRT refs above). -->
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(Lb10Root)\Core\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(Lb10Root)\Core\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Managed wrapper over libvlc (video thumbnails now, in-app playback later). 225 KB, no transitive
         managed deps, so it is simply a 5th app file (keep build-release.ps1 $appFiles + LightPayload.Files +
         the light/<tfm>/* block below in sync).
         We ship NO libvlc natives: LaunchBox ALREADY bundles a full libvlc 3.0.23 at ThirdParty\VLC\x64 (366
         plugins) — the very one it plays videos with. VlcService points at it, so this costs 0 MB instead of
         the ~13 MB a trimmed copy of our own would have added. -->
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <!-- zstd decompression for the Extended-DB release archives (Host\Data\ExtDbDownloader). Managed-only
         (no native deps) — the same codec the ExtendDB plugin restores with, so archives decode identically.
         Like LibVLCSharp above, it becomes an extra loose app DLL: keep build-release.ps1 $appFiles +
         LightPayload.Files + the light/<tfm>/* EmbeddedResource block in sync when shipping it. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
    <!-- ONNX Runtime MANAGED wrapper only (duplicate-image detection — Host/Media/Dedup). Deliberately the
         .Managed package (no native assets): the natives (onnxruntime.dll + DirectML.dll, ~33 MB) and the
         MobileNetV3 embedding model ship through the thirdparty payload to ThirdParty\ImageDedup\ and are
         preloaded by full path (CnnEmbedder.PreloadNatives) — keep the managed/native versions in lockstep
         (1.20.1 ↔ the bundled onnxruntime.dll.api). Loose app DLL (Microsoft.ML.OnnxRuntime.dll): keep
         build-release.ps1 $appFiles + LightPayload.Files + the light/<tfm> EmbeddedResource block in sync. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.20.1" />
    <!-- Harmony: runtime method patching, used by the MAME leaderboard key ORACLE (Host/Diag/MameKeyHook.cs):
         hook the core's BouncyCastle cipher in-process to read the current upload key, and block the outbound
         POST so nothing is sent. Diagnostic path only (the mame-keyhook flag); the shipping upload just calls
         GamesDatabase.UploadMameHighScore directly. Loose app DLL (0Harmony.dll): keep deploy lists in sync. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <!-- Windows Display / CCD wrapper (Host\Monitors — the Monitor Profiles module). Managed-only,
         netstandard2.0, ZERO transitive deps: it wraps QueryDisplayConfig/SetDisplayConfig,
         EnumDisplaySettings/ChangeDisplaySettingsEx and the per-source DPI scaling that we would
         otherwise have to P/Invoke by hand (~2200 lines of struct marshalling). Crucially it resolves
         a monitor by its DevicePath + EDID rather than by the adapter LUID, which is what makes a
         saved layout survive a reboot or a GPU swap. LGPL-3.0, referenced unmodified (dynamic link).
         Loose app DLL (WindowsDisplayAPI.dll): keep build-release.ps1 $appFiles + LightPayload.Files +
         the light/<tfm>/* EmbeddedResource block below in sync. -->
    <PackageReference Include="WindowsDisplayAPI" Version="1.3.0.13" />
    <!-- NVIDIA NVAPI wrapper (Host\Monitors\GpuColor: GPU-output colour control for monitor profiles).
         Same author/licence/pattern as WindowsDisplayAPI above. It P/Invokes nvapi64.dll, which only
         exists where an NVIDIA driver is installed: every touch point is vendor-gated per MONITOR (the
         adapter DevicePath carries VEN_10DE) and wrapped, so AMD/Intel machines, and non-NVIDIA monitors
         on mixed machines, report "not supported" instead of failing. Loose app DLL (NvAPIWrapper.dll):
         keep build-release.ps1 $appFiles + LightPayload.Files + deploy-dev.ps1 $hostFiles + the
         light/<tfm>/* EmbeddedResource block below in sync. -->
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
  </ItemGroup>

  <!-- LaunchBox-compatibility shim (LbShim\) — an assembly whose IDENTITY is "LaunchBox", carrying
       LaunchBox's public Notifications API forwarded to LiteBox's notification center, so a plugin that
       reflects for `GetAssemblies().First(a => a.Name == "LaunchBox")` keeps working here (see
       Host\Notifications\LaunchBoxShim.cs).
       It is EMBEDDED and loaded from memory, never copied next to LiteBox.exe: the exe lives in <LB>\Core
       beside the REAL LaunchBox.dll, and a file of that name there would overwrite LaunchBox's own.
       ReferenceOutputAssembly=false: LiteBox must NOT bind to it at compile time (the CLR would then
       resolve "LaunchBox" from Core — the real one — before we ever get to load ours). -->
  <PropertyGroup>
    <!-- The shim is single-TFM (net9 — a net9 library loads fine on the net10 runtime), so its output
         path does not depend on which TFM of LiteBox is building. -->
    <LbShimDll>$(MSBuildThisFileDirectory)LbShim\bin\$(Configuration)\net9.0-windows\LaunchBox.dll</LbShimDll>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LbShim\**" />
    <EmbeddedResource Remove="LbShim\**" />
    <None Remove="LbShim\**" />
    <!-- native/ holds the standalone C++ ASI + managed LaunchBox plugin (their own builds) —
         never part of the LiteBox host compile. -->
    <Compile Remove="native\**" />
    <EmbeddedResource Remove="native\**" />
    <None Remove="native\**" />
    <!-- UndefineProperties: without it the net10 build pushes TargetFramework=net10.0-windows down into
         the shim and fails its restore. -->
    <ProjectReference Include="LbShim\LbShim.csproj" ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" UndefineProperties="TargetFramework" />
    <!-- Declared statically (not appended from a target): resource NAMES are assigned early in the build,
         before the ProjectReference has produced anything, so an item added later is silently ignored. A
         literal Include needs no file at evaluation time — only by the time the compiler runs, which the
         ProjectReference above guarantees. Placed AFTER the Remove above, which would otherwise drop it. -->
    <EmbeddedResource Include="$(LbShimDll)"><LogicalName>shim/LaunchBox.dll</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Target Name="CheckLaunchBoxShim" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(LbShimDll)')"
           Text="LbShim output missing ($(LbShimDll)) — the LaunchBox-compatibility shim must build first; LaunchBox plugins would silently lose notifications." />
  </Target>

  <ItemGroup>
    <!-- Fallback hero fanart, used when a game/node has no background of its own. -->
    <EmbeddedResource Include="defaultFanart.jpg" />
    <!-- App/window icon (also embedded so the WinForms window + taskbar use the multi-size icon). -->
    <EmbeddedResource Include="litebox.ico" />
    <!-- FBNeo hiscore.dat (328 KB): the score-support DB the RetroArch FBNeo core needs to WRITE .hi files.
         Embedded in BOTH dists (unlike the multi-MB natives below) since it's small and the FBNeo-upload
         feature is useless without it. Deployed into <RetroArch>\system\fbneo\ when that option is enabled
         (Host/Mame/FbneoHiscore.cs). -->
    <EmbeddedResource Include="thirdparty\hiscore.dat"><LogicalName>natives/fbneo-hiscore.dat</LogicalName></EmbeddedResource>
    <!-- LaunchBox's hardcoded per-platform 3D model defaults, FROZEN to a table (41 platforms) so the preset
         chain needs NO LaunchBox core at runtime. Regenerate per LB version: LiteBox.exe
         [dash][dash]model-defaults-extract <thisfile>  (enumerates every Metadata-db platform name + alternates
         and drives ModelSettings.GetDefaultSettings once per name). ModelDefaults.cs reads it. -->
    <EmbeddedResource Include="model-defaults.json"><LogicalName>LbApiHost.model-defaults.json</LogicalName></EmbeddedResource>
    <!-- The 3D case models (.obj/.mtl as .txt) + jewel spine preset images, extracted ONCE from LaunchBox's
         JewelCaseSpines.resources (LiteBox.exe [dash][dash]model-export) and SHIPPED (user-approved) so the 3D
         renderer needs no LaunchBox dll at runtime. LbCaseObj reads these first, LB dll = fallback. -->
    <EmbeddedResource Include="case-assets\**"><LogicalName>case-assets/%(Filename)%(Extension)</LogicalName></EmbeddedResource>

